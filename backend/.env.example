# Copy to .env and adjust. Never commit .env.
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sequencer?sslmode=disable
ALLOWED_ORIGINS=http://localhost:5173
# 5 hours. Set to 60000 (1 minute) to demo the cycle-boundary restart quickly.
CYCLE_MS=18000000
SYNC_LEAD_MS=1500
SEED_ON_START=true
